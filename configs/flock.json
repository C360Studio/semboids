{
  "version": "1.2.0",
  "platform": {
    "org": "c360",
    "id": "semboids",
    "type": "simulation",
    "region": "local",
    "instance_id": "semboids-001",
    "environment": "development"
  },
  "nats": {
    "urls": [
      "nats://localhost:4222"
    ]
  },
  "streams": {
    "ENTITY": {
      "subjects": [
        "entity.>"
      ],
      "storage": "file",
      "max_age": "24h",
      "max_bytes": 2147483648,
      "discard": "old",
      "replicas": 1
    }
  },
  "services": {
    "service-manager": {
      "enabled": true,
      "config": {
        "http_port": 8080,
        "swagger_ui": true,
        "server_info": {
          "title": "SemBoids API",
          "description": "Reynolds boids simulator on the SemStreams substrate",
          "version": "0.1.0"
        }
      }
    },
    "component-manager": {
      "enabled": true,
      "config": {}
    },
    "metrics": {
      "enabled": true,
      "config": {
        "port": 9090,
        "path": "/metrics"
      }
    },
    "boids": {
      "enabled": true,
      "config": {}
    }
  },
  "components": {
    "sim": {
      "type": "input",
      "name": "sim",
      "enabled": true,
      "config": {
        "boids": 200,
        "tick_hz": 30,
        "seed": 1,
        "zones": [
          {
            "id": "pred-1",
            "type": "predator",
            "x": 500,
            "y": 450,
            "r": 90,
            "strength": 1.0
          },
          {
            "id": "food-1",
            "type": "food",
            "x": 1150,
            "y": 300,
            "r": 100,
            "strength": 0.6
          },
          {
            "id": "wind-1",
            "type": "wind",
            "x": 800,
            "y": 700,
            "r": 140,
            "strength": 0.4,
            "dx": 1,
            "dy": 0
          }
        ],
        "ports": {
          "inputs": [],
          "outputs": [
            {
              "name": "frames",
              "required": true,
              "description": "Aggregated flock frame per tick (compact JSON)",
              "config": {
                "kind": "nats",
                "subject": "boids.frames"
              }
            },
            {
              "name": "graph_mutations",
              "required": true,
              "description": "Typed graph mutations: neighbor-set reconcile on emptying, fenced entity delete on cull reclaim",
              "config": {
                "kind": "nats-request",
                "subject": "graph.mutation.>",
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                }
              }
            }
          ]
        },
        "graph_hz": 1,
        "cull_grace_ticks": 90
      }
    },
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "entity_stream",
              "description": "Batched boid/zone Graphable snapshots (the load-dial firehose)",
              "config": {
                "kind": "jetstream",
                "stream_name": "ENTITY",
                "subjects": [
                  "entity.>"
                ]
              }
            },
            {
              "name": "graph_mutations",
              "required": true,
              "description": "Typed graph mutation provider (sole ENTITY_STATES writer)",
              "config": {
                "kind": "nats-request",
                "subject": "graph.mutation.>",
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                }
              }
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "config": {
                "kind": "kv-write",
                "bucket": "ENTITY_STATES"
              }
            }
          ]
        }
      }
    },
    "rule-processor": {
      "type": "processor",
      "name": "rule-processor",
      "enabled": true,
      "config": {
        "pack_id": "semboids",
        "rules_files": [
          "configs/rules/zone-steering/predator.json",
          "configs/rules/zone-steering/food.json",
          "configs/rules/zone-steering/wind.json"
        ],
        "enable_graph_integration": false,
        "ports": {
          "inputs": [
            {
              "name": "zone_events",
              "required": true,
              "description": "Zone transition events from the sim",
              "config": {
                "kind": "nats",
                "subject": "boids.zone.events"
              }
            }
          ],
          "outputs": [
            {
              "name": "steering",
              "description": "TTL'd steering modifiers back to the sim",
              "config": {
                "kind": "nats",
                "subject": "boids.steering"
              }
            }
          ]
        }
      }
    },
    "frames-websocket": {
      "type": "output",
      "name": "websocket",
      "enabled": true,
      "config": {
        "delivery_mode": "at-most-once",
        "ports": {
          "inputs": [
            {
              "name": "nats_input",
              "required": true,
              "description": "Flock frames to fan out to browsers",
              "config": {
                "kind": "nats",
                "subject": "boids.frames"
              }
            }
          ],
          "outputs": [
            {
              "name": "websocket_server",
              "description": "WebSocket server endpoint for browser clients",
              "config": {
                "kind": "network",
                "protocol": "http",
                "host": "0.0.0.0",
                "port": 8081
              }
            }
          ]
        }
      }
    },
    "graph-index": {
      "type": "processor",
      "name": "graph-index",
      "enabled": true,
      "config": {
        "coalesce_ms": 500,
        "ports": {
          "inputs": [
            {
              "name": "entity_watch",
              "config": {
                "kind": "kv-watch",
                "bucket": "ENTITY_STATES"
              }
            }
          ],
          "outputs": [
            {
              "name": "outgoing_index",
              "config": {
                "kind": "kv-write",
                "bucket": "OUTGOING_INDEX"
              }
            },
            {
              "name": "incoming_index",
              "config": {
                "kind": "kv-write",
                "bucket": "INCOMING_INDEX"
              }
            },
            {
              "name": "alias_index",
              "config": {
                "kind": "kv-write",
                "bucket": "ALIAS_INDEX"
              }
            },
            {
              "name": "predicate_index",
              "config": {
                "kind": "kv-write",
                "bucket": "PREDICATE_INDEX"
              }
            }
          ]
        }
      }
    },
    "graph-clustering": {
      "type": "processor",
      "name": "graph-clustering",
      "enabled": true,
      "config": {
        "detection_interval": "2s",
        "batch_size": 50,
        "min_community_size": 3,
        "enable_llm": false,
        "entity_id_edges": {
          "include_siblings": false,
          "include_system_peers": false
        },
        "ports": {
          "inputs": [
            {
              "name": "entity_watch",
              "config": {
                "kind": "kv-watch",
                "bucket": "ENTITY_STATES"
              }
            },
            {
              "name": "entity_states",
              "config": {
                "kind": "kv-read",
                "bucket": "ENTITY_STATES"
              }
            },
            {
              "name": "outgoing_index",
              "config": {
                "kind": "kv-read",
                "bucket": "OUTGOING_INDEX"
              }
            },
            {
              "name": "incoming_index",
              "config": {
                "kind": "kv-read",
                "bucket": "INCOMING_INDEX"
              }
            }
          ],
          "outputs": [
            {
              "name": "graph_mutations",
              "required": true,
              "description": "Community summary mutations through the typed graph write contract",
              "config": {
                "kind": "nats-request",
                "subject": "graph.mutation.>",
                "interface": {
                  "type": "semstreams.graph.mutation",
                  "version": "v1"
                }
              }
            },
            {
              "name": "communities",
              "config": {
                "kind": "kv-write",
                "bucket": "COMMUNITY_INDEX"
              }
            }
          ]
        }
      }
    }
  }
}
